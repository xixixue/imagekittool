# ImageKitTools environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# IMPORTANT: Core local image tools work WITHOUT any of the cloud / database /
# email variables below. Leave those empty to run the site with cloud features
# shown as "unavailable" rather than failing to start.
#
# NEXT_PUBLIC_* variables are exposed to the browser and must NEVER contain secrets.

# --- App ---
NODE_ENV=development
# Dev uses localhost. In production (Vercel env var) set this to https://imagekittool.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Phase 2+) ---
# PostgreSQL (Neon) pooled connection string used by Prisma in BOTH dev and prod.
# Include ?sslmode=require. Prisma's engine does not support channel_binding=require — drop it.
DATABASE_URL=

# --- Authentication (Phase 2) ---
# Sessions are server-side: opaque random tokens stored hashed in the DB, so no
# signing secret is required for the MVP. AUTH_SECRET is reserved for future use.
AUTH_SECRET=

# --- Email (Phase 2) ---
# Resend (resend.com) powers verification and password-reset emails in production.
# `EMAIL_FROM` must use a sending domain verified in Resend (DNS MX/SPF/DKIM).
# Leave both empty to fall back to a console sender that logs the message (dev).
RESEND_API_KEY=
EMAIL_FROM=

# --- S3-compatible object storage (Phase 3) ---
# Cloudflare R2 (recommended) or any S3-compatible provider.
# R2: S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto.
# Leave empty to disable cloud storage (core local tools keep working).
# NOTE: the bucket must allow CORS from the app origin for browser-direct PUT/GET.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Monitoring (Phase 4) ---
# Server-side DSN (reserved for future @sentry/nextjs instrumentation).
SENTRY_DSN=
# Public DSN used by the browser SDK. Empty = no Sentry script is loaded.
NEXT_PUBLIC_SENTRY_DSN=

# --- Analytics (Phase 4) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Ads (AdSense) ---
# Publisher client ID (ca-pub-XXXXXXXXXXXXXXXX). Leave empty until your AdSense
# account is approved and you have created ad units. When empty, no AdSense
# script loads and every <AdSlot/> renders nothing (see ADS.md).
NEXT_PUBLIC_ADSENSE_CLIENT=

# --- Guide cover generation (local build script only, NOT production) ---
# Used by `scripts/generate-guide-covers.py` to call the wan2.7-image-pro
# text-to-image API when regenerating the /guides cover illustrations. Not
# needed at runtime — the generated WebP covers are committed to public/guides/.
# Never commit real values; keep them in .env only.
WAN_API_BASE=
WAN_API_KEY=
