{
  "name": "imagekittools",
  "version": "0.1.0",
  "private": true,
  "description": "ImageKitTools — privacy-first online image tools (compress, resize, convert, crop, compress-to-KB). Browser-local processing, optional personal cloud storage.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "@hookform/resolvers": "^3.0.0",
    "@node-rs/argon2": "^2.0.0",
    "@prisma/client": "^6.0.0",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "fflate": "^0.8.2",
    "next": "^15.1.0",
    "next-intl": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^5.0.8",
    "react-hook-form": "^7.0.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "prettier": "^3.4.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
